# Local MongoDB, or replace with your MongoDB Atlas connection URI.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=videoaiditor
PORT=3000

# Change this to a long random value in any real deployment.
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d

# Edit-plan LLM (core/llm.ts resolves the model from these; swap provider by
# adding a case there, not by changing call sites).
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash
GOOGLE_GENERATIVE_AI_API_KEY=

# Whisper model id for @huggingface/transformers (word-level timestamps need
# a non-merged-decoder ONNX export — Xenova/whisper-* works, onnx-community/*
# does not, see whisper.service.ts).
WHISPER_MODEL=Xenova/whisper-base
